views:
  - type: table
    name: Table
    sort: []
  - type: cards
    name: View
    filters:
      and:
        - file.inFolder("Books")
    order:
      - file.name
      - file.basename
      - file.backlinks
      - file.embeds
      - file.ctime
      - file.ext
      - file.folder
      - file.fullname
      - file.mtime
      - file.path
      - file.size
      - author
      - file.tags
      - comment
      - cover
      - excalidraw-plugin
      - pages
      - lists
      - published
      - rating
      - tags
      - file.links
    sort:
      - property: file.basename
        direction: ASC
    cardSize: 240
    image: note.cover
    imageFit: contain
