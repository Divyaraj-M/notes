views:
  - type: table
    name: My Books
    filters:
      and:
        - file.inFolder("Books")
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - author
      - file.tags
      - pages
      - lists
      - file.basename
      - file.mtime
    sort:
      - property: file.tags
        direction: ASC
    cardSize: 340
    image: note.cover
    imageFit: contain
