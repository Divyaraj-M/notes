formulas:
  Untitled: ""
views:
  - type: table
    name: Habit Tracker
    filters:
      and:
        - file.folder == "1 - Projects/Habit Tracker"
        - and:
            - file.name != "Habit Tracker"
            - file.basename != "Habit Tracker"
    order:
      - file.name
      - file.backlinks
      - formula.Untitled
      - tags
    sort:
      - property: tags
        direction: ASC
      - property: formula.Untitled
        direction: DESC
  - type: table
    name: Table
