views:
  - type: table
    name: Table
  - type: table
    name: SparrowCrm
    filters:
      and:
        - file.inFolder("1 - Projects/Sparrowcrm")
    order:
      - file.name
      - status
      - priority_score
      - quarter
      - file.tags
      - effort
      - impact
      - feature
      - file.backlinks
    sort:
      - property: owner
        direction: DESC
