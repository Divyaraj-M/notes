		{
			"id": "0PNuSszY",
			"type": "text",
			"x": 120,
			"y": 885,
			"width": 616,
			"height": 175,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"roundness": null,
			"seed": 7002,
			"version": 2,
			"isDeleted": false,
			"boundElements": [],
			"link": null,
			"locked": false,
			"text": "RELATIONSHIP SUMMARY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n• Contact → Company:   Many-to-One (each contact belongs to 1 company)\n• Contact ↔ Deal:      Many-to-Many (multiple contacts per deal, vice versa)\n• Contact ↔ Meeting:   Many-to-Many (multiple attendees per meeting)\n• Company → Deal:      One-to-Many (1 company can have many deals)\n• Company → Meeting:   One-to-Many (1 company can have many meetings)\n• Deal ↔ Meeting:      Many-to-Many (meetings can span multiple deals)\n\nAll associations are BIDIRECTIONAL — updating one side auto-updates the other.",
			"fontSize": 14,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "RELATIONSHIP SUMMARY\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n• Contact → Company:   Many-to-One (each contact belongs to 1 company)\n• Contact ↔ Deal:      Many-to-Many (multiple contacts per deal, vice versa)\n• Contact ↔ Meeting:   Many-to-Many (multiple attendees per meeting)\n• Company → Deal:      One-to-Many (1 company can have many deals)\n• Company → Meeting:   One-to-Many (1 company can have many meetings)\n• Deal ↔ Meeting:      Many-to-Many (meetings can span multiple deals)\n\nAll associations are BIDIRECTIONAL — updating one side auto-updates the other.",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 1213684264,
			"index": "aM",
			"frameId": null,
			"updated": 1777793827461,
			"hasTextLink": false,
			"rawText": ""
		},
