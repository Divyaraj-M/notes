			"boundElements": [],
			"link": null,
			"locked": false,
			"text": "KEY INSIGHT: There are NO direct foreign keys between entity tables (no company_id on contacts).\nALL cross-object links go through a generic junction table: object_attribute_reference_values.\nThis is an EAV (Entity-Attribute-Value) pattern — flexible but indirect.",
			"fontSize": 14,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "KEY INSIGHT: There are NO direct foreign keys between entity tables (no company_id on contacts).\nALL cross-object links go through a generic junction table: object_attribute_reference_values.\nThis is an EAV (Entity-Attribute-Value) pattern — flexible but indirect.",
