			"isDeleted": false,
			"boundElements": [],
			"link": null,
			"locked": false,
			"text": "object_attribute_reference_values\n(THE MASTER JUNCTION TABLE — all links live here)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPK: id (BIGINT)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFK: account_id       → accounts\nFK: object_id        → objects (source object type)\nFK: object_record_id → contacts/companies/deals/meetings\n     (polymorphic — the SOURCE record)\nFK: attribute_id     → object_attributes\n     (which association attribute)\n    object_type       (CONTACT|COMPANY|DEAL|MEETING)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFK: value_object_record_id → TARGET record id\nFK: value_object_id        → TARGET object type id\nFK: value_stage_id         → stage_attribute_values\nFK: value_pipeline_id      → pipelines\nFK: value_user_record_id   → users\nFK: value_item_id          → object_attribute_items\n     (for select/multi-select/status)",
			"fontSize": 13,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "object_attribute_reference_values\n(THE MASTER JUNCTION TABLE — all links live here)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPK: id (BIGINT)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFK: account_id       → accounts\nFK: object_id        → objects (source object type)\nFK: object_record_id → contacts/companies/deals/meetings\n     (polymorphic — the SOURCE record)\nFK: attribute_id     → object_attributes\n     (which association attribute)\n    object_type       (CONTACT|COMPANY|DEAL|MEETING)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFK: value_object_record_id → TARGET record id\nFK: value_object_id        → TARGET object type id\nFK: value_stage_id         → stage_attribute_values\nFK: value_pipeline_id      → pipelines\nFK: value_user_record_id   → users\nFK: value_item_id          → object_attribute_items\n     (for select/multi-select/status)",
