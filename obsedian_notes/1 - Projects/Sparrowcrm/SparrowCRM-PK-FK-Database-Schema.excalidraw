		{
			"id": "UuL9hcf2",
			"type": "text",
			"x": 100,
			"y": 1710,
			"width": 692.4962158203125,
			"height": 211.25,
			"angle": 0,
			"strokeColor": "#1e1e1e",
			"backgroundColor": "transparent",
			"fillStyle": "solid",
			"strokeWidth": 1,
			"strokeStyle": "solid",
			"roughness": 1,
			"opacity": 100,
			"groupIds": [],
			"roundness": null,
			"seed": 1101,
			"version": 2,
			"isDeleted": false,
			"boundElements": [],
			"link": null,
			"locked": false,
			"text": "Say Contact \"John\" (id=42) belongs to Company \"Acme\" (id=99):\n\nobject_attribute_reference_values row:\n  object_record_id       = 42        ← John's contact record id\n  attribute_id           = 501       ← the \"contact_company\" attribute definition\n  object_type            = CONTACT\n  value_object_record_id = 99        ← Acme's company record id\n  value_object_id        = 7         ← the COMPANY object type id\n\nAND a mirrored row exists for the reverse (Acme → John) using the \"company_contacts\" attribute.\nThis is auto-created by publishAssociationBidirectionalUpdate() in base-record-mutation.service.ts.\n\nThere is NO company_id column on the contacts table. The link lives entirely in the reference values table.",
			"fontSize": 13,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "Say Contact \"John\" (id=42) belongs to Company \"Acme\" (id=99):\n\nobject_attribute_reference_values row:\n  object_record_id       = 42        ← John's contact record id\n  attribute_id           = 501       ← the \"contact_company\" attribute definition\n  object_type            = CONTACT\n  value_object_record_id = 99        ← Acme's company record id\n  value_object_id        = 7         ← the COMPANY object type id\n\nAND a mirrored row exists for the reverse (Acme → John) using the \"company_contacts\" attribute.\nThis is auto-created by publishAssociationBidirectionalUpdate() in base-record-mutation.service.ts.\n\nThere is NO company_id column on the contacts table. The link lives entirely in the reference values table.",
			"autoResize": true,
			"lineHeight": 1.25,
			"versionNonce": 358695720,
			"index": "aO",
			"frameId": null,
			"updated": 1777794238933,
			"hasTextLink": false,
			"rawText": ""
		},
