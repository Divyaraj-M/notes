			"boundElements": [],
			"link": null,
			"locked": false,
			"text": "object_attributes (Field Definitions)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPK: id (BIGINT)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFK: object_id → objects\nFK: account_id → accounts\nFK: associated_attribute_id → self\n     (for bidirectional links)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n   name / display_name / slug\n   data_type (ENUM):\n     text|number|email|date|select|\n     multi_select|currency|record|\n     user|status|ASSOCIATION|location|\n     phone|boolean|url|PIPELINE|\n     STAGE|PIPELINE_STAGE\n   is_system / is_required",
			"fontSize": 13,
			"fontFamily": 1,
			"textAlign": "left",
			"verticalAlign": "top",
			"containerId": null,
			"originalText": "object_attributes (Field Definitions)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nPK: id (BIGINT)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\nFK: object_id → objects\nFK: account_id → accounts\nFK: associated_attribute_id → self\n     (for bidirectional links)\n━━━━━━━━━━━━━━━━━━━━━━━━━━━━\n   name / display_name / slug\n   data_type (ENUM):\n     text|number|email|date|select|\n     multi_select|currency|record|\n     user|status|ASSOCIATION|location|\n     phone|boolean|url|PIPELINE|\n     STAGE|PIPELINE_STAGE\n   is_system / is_required",
