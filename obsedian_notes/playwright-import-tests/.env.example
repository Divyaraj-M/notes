# Copy this file to `.env` and fill in real values. Do NOT commit `.env`.
BASE_URL=https://app.surveysparrow.com

# Test account used by global.setup.ts to create the logged-in session
TEST_USER_EMAIL=your-test-user@example.com
TEST_USER_PASSWORD=change-me

# Optional: paths inside the app (adjust to your build)
CONTACTS_IMPORT_PATH=/crm/contacts
COMPANIES_IMPORT_PATH=/crm/companies
DEALS_IMPORT_PATH=/crm/deals
